# Copy to backend/.env before running: cp backend/.env.example backend/.env
# Then fill in your API keys. Docker Compose overrides DB_* to point at the postgres service.

# AWS (Transcribe STS + Bedrock LLM)
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# LLM: anthropic | bedrock
LLM_PROVIDER=bedrock
AWS_BEDROCK_REGION=ap-northeast-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# Google (STT + TTS) — mount JSON at backend/credentials/google-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json
GOOGLE_API_KEY=your_google_api_key

# Optional
DEBUG=true
