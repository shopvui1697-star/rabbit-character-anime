# Copy to backend/.env before running: cp backend/.env.example backend/.env
# Then fill in your API keys. MySQL runs on an existing external server — set
# DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD/DB_SSL below to point at it; Docker
# Compose no longer hosts or overrides a local DB container.

# MySQL (existing server — no local container)
DB_HOST=your_mysql_host
DB_PORT=3306
DB_NAME=rabbit_movies
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_SSL=false

# AWS (Transcribe STS + Bedrock LLM)
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# LLM: anthropic (9Router or direct) | bedrock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_9router_api_key
ANTHROPIC_BASE_URL=http://host.docker.internal:20128
ANTHROPIC_MODEL=my-combo

# Alternative: AWS Bedrock
# LLM_PROVIDER=bedrock
# AWS_BEDROCK_REGION=ap-northeast-1
# AWS_BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# Google (web search only — TTS/STT go through 9Router)
GOOGLE_API_KEY=your_google_api_key

# 9Router TTS + STT
NINEROUTER_TTS_VOICE_FEMALE=edge-tts/en-US-JennyNeural
NINEROUTER_TTS_VOICE_MALE=edge-tts/en-US-GuyNeural
NINEROUTER_STT_MODEL=groq/whisper-large-v3-turbo

# Optional
DEBUG=true
