# frontend/.env.local
NEXT_PUBLIC_STT_RMS_THRESHOLD=0.012       # ngưỡng VAD (tăng nếu vẫn nhiễu)
NEXT_PUBLIC_STT_RMS_HANGOVER_MS=900       # giữ gửi audio sau khi nói xong
NEXT_PUBLIC_STT_INTERIM_STABILITY_MS=2500 # chờ lâu hơn trước auto-submit

# Fast VAD (barge-in ducking) — xem BARGE_IN_CONFIG.md §9.4.C
NEXT_PUBLIC_VAD_CONFIRM_MS=200            # RMS liên tục vượt ngưỡng bao lâu mới coi là "đang nói"
NEXT_PUBLIC_VAD_RELEASE_MS=200            # RMS liên tục dưới ngưỡng bao lâu mới coi là "hết nói"
NEXT_PUBLIC_TTS_VAD_DUCK_VOLUME=0.08      # mức duck sâu khi VAD xác nhận có giọng nói

