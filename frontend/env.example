# frontend/.env.local
NEXT_PUBLIC_STT_RMS_THRESHOLD=0.012       # ngưỡng VAD (tăng nếu vẫn nhiễu)
NEXT_PUBLIC_STT_RMS_HANGOVER_MS=900       # giữ gửi audio sau khi nói xong
NEXT_PUBLIC_STT_INTERIM_STABILITY_MS=2500 # chờ lâu hơn trước auto-submit

# Fast VAD (barge-in ducking) — xem BARGE_IN_CONFIG.md §9.4.C
NEXT_PUBLIC_VAD_CONFIRM_MS=200            # RMS liên tục vượt ngưỡng bao lâu mới coi là "đang nói"
NEXT_PUBLIC_VAD_RELEASE_MS=200            # RMS liên tục dưới ngưỡng bao lâu mới coi là "hết nói"
NEXT_PUBLIC_TTS_VAD_DUCK_VOLUME=0.08      # mức duck sâu khi VAD xác nhận có giọng nói

# VAD ngưỡng thích ứng theo noise floor — xem BARGE_IN_CONFIG.md §7.1.C (v2)
NEXT_PUBLIC_VAD_NOISE_FLOOR_ALPHA=0.05    # tốc độ EMA theo dõi noise floor (thấp = mượt/chậm hơn)
NEXT_PUBLIC_VAD_ADAPTIVE_MULTIPLIER=3.0   # ngưỡng nói = noise floor * hệ số này (NEXT_PUBLIC_STT_RMS_THRESHOLD là sàn tối thiểu)

# AEC — NLMS echo canceller thật (reference signal = chính audio TTS đang phát), xem BARGE_IN_CONFIG.md §7.1.A (v2)
NEXT_PUBLIC_AEC_ENABLED=true
NEXT_PUBLIC_AEC_TAP_COUNT=512             # số tap filter (~10-15ms tại 48kHz) — tăng = bắt echo dài hơn nhưng tốn CPU hơn
NEXT_PUBLIC_AEC_STEP_SIZE=0.3             # tốc độ học NLMS (mu); 0.2-0.5 ổn định, càng cao hội tụ nhanh hơn nhưng nhiễu hơn
NEXT_PUBLIC_AEC_MAX_DELAY_MS=250          # phạm vi tìm delay (loa→mic), 250ms đủ cho hầu hết laptop/phone

