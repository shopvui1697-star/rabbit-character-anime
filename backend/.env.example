# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Debug Mode
# Set to true to enable console logging and session log files
# Set to false or remove to disable ALL logging (production mode)
DEBUG=true

# AWS Configuration (for Transcribe + Bedrock)
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# AWS Transcribe STS Configuration (Optional - for enhanced security)
# If set, backend will use AssumeRole to generate temporary credentials
# If not set, backend will use GetSessionToken with the credentials above
# AWS_TRANSCRIBE_ROLE_ARN=arn:aws:iam::123456789012:role/RabbitTranscribeRole

# LLM Provider Configuration
# Options: "anthropic" (direct API or 9Router) or "bedrock" (AWS Bedrock)
LLM_PROVIDER=anthropic

# Anthropic Claude API (when LLM_PROVIDER=anthropic)
# --- Direct Anthropic API ---
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- 9Router combo (recommended) ---
# 1. Start 9Router and create a combo in the dashboard (e.g. "my-combo")
# 2. Use the dashboard API key and set ANTHROPIC_MODEL to your combo name
# 3. For Docker backend, use host.docker.internal instead of localhost:
#    ANTHROPIC_BASE_URL=http://host.docker.internal:20128
ANTHROPIC_API_KEY=your_9router_api_key
ANTHROPIC_BASE_URL=http://localhost:20128
ANTHROPIC_MODEL=my-combo

# 9Router TTS + STT (defaults reuse ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY above)
# NINEROUTER_URL=http://localhost:20128
# NINEROUTER_KEY=your_9router_api_key
NINEROUTER_TTS_VOICE_FEMALE=edge-tts/en-US-JennyNeural
NINEROUTER_TTS_VOICE_MALE=edge-tts/en-US-GuyNeural
# Configure an STT provider in 9Router dashboard first (Groq, Gemini, OpenAI, etc.)
NINEROUTER_STT_MODEL=groq/whisper-large-v3-turbo
NINEROUTER_STT_INTERVAL_MS=1200
# Or bypass 9Router STT and call Groq directly (free tier: console.groq.com/keys)
# Must be an API key starting with gsk_ — NOT an organization ID (org_...)
# GROQ_API_KEY=gsk_your_groq_api_key

# AWS Bedrock Configuration (when LLM_PROVIDER=bedrock)
# Uses AWS credentials above
AWS_BEDROCK_REGION=ap-northeast-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=japaneast

# Optional: Override default voices
# AZURE_VOICE_FEMALE=en-US-JennyNeural
# AZURE_VOICE_MALE=en-US-GuyNeural

# Optional: TTS Enhancement Controls (for A/B testing naturalness)
# AZURE_ENABLE_PROSODY=true          # false = disable breaks/prosody adjustments
# AZURE_MINIMAL_SSML=false           # true = use only basic SSML (plain text baseline)
# Optional: Override default voices
# AZURE_VOICE_FEMALE=en-US-JennyNeural
# AZURE_VOICE_MALE=en-US-GuyNeural

# TTS Enhancement Flags (for A/B testing naturalness)
# AZURE_ENABLE_PROSODY=true        # Enable sentence-level breaks (default: true)
# AZURE_MINIMAL_SSML=false         # Use minimal SSML (plain text only, default: false)

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rabbit_movies
DB_USER=postgres
DB_PASSWORD=postgres

# backend/.env
STT_MIN_SPEECH_RMS=0.012                  # ngưỡng RMS backend